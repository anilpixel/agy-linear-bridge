PORT=8787
HOST=127.0.0.1
PUBLIC_BASE_URL=https://your-public-tunnel.example.com

# Linear OAuth App credentials (from Linear Settings -> API -> Applications)
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=
LINEAR_WEBHOOK_SECRET=
LINEAR_OAUTH_SCOPES=read,write,app:assignable,app:mentionable
# oauth (recommended: browser install with actor=app) | client_credentials
LINEAR_AUTH_MODE=oauth
WEBHOOK_MAX_AGE_MS=300000

# Routing ("hybrid" = deterministic rules first, stateless agy Flash fallback; "rules" = deterministic only)
ROUTER_MODE=hybrid
ROUTER_MODEL=gemini-3.8-flash-low
ROUTER_TIMEOUT_MS=90000

# Antigravity Remote Agent launcher
AGY_REMOTE_MODE=accept-edits
MAX_CONCURRENT_LAUNCHES=2
LAUNCH_DETACH_MODE=true
AGY_BIN=agy
PYTHON_BIN=python3

# Repository WORKFLOW.md policy loader (via local checkout or `gh api`)
WORKFLOW_FETCH_ENABLED=true
WORKFLOW_CACHE_TTL_MS=300000
WORKFLOW_TIMEOUT_MS=8000
GH_BIN=gh

# GitHub Webhook CI/Review closed-loop (POST /webhooks/github)
GITHUB_WEBHOOK_SECRET=
GITHUB_CI_AUTO_FIX=true
GITHUB_REVIEW_AUTO_RESUME=true
GITHUB_MAX_CI_FIX_ROUNDS=3
GITHUB_IGNORED_ACTORS=
